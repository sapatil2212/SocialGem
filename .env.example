# For local work, put DATABASE_URL and TEST_DATABASE_URL for a MySQL on this computer in .env.local.
# MySQL 8. Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL="mysql://user:password@host:3306/socialgem"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

MUAPI_API_KEY="your_muapi_api_key"

STRIPE_SECRET_KEY="your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"

# Public contact details (optional; hidden until set)
SUPPORT_EMAIL=""
CONTACT_PHONE=""
CONTACT_WHATSAPP=""

# Email for sign-in codes. 465 is SMTPS; 587 must upgrade to TLS or nothing is sent.
EMAIL_HOST=""
EMAIL_PORT="465"
EMAIL_USERNAME=""
EMAIL_PASSWORD="" # for Gmail, an app password
EMAIL_FROM="" # optional
EMAIL_BCC="" # ordinary mail only, never codes

# Platforms customers may connect and schedule to
PLATFORMS_ENABLED="facebook,instagram,youtube,tiktok,x,linkedin,pinterest"

# Super admin at /admin/login. ADMIN_USER is an email.
# ADMIN_PASS needs 14 or more characters. Use letters, numbers, - and _ only.
ADMIN_USER=""
ADMIN_PASS=""

# AI studio. Claude writes and plans; Gemini makes images (needs billing switched on).
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
# Spending limits in US dollars
AI_WORKSPACE_MONTHLY_USD="5"
AI_TOTAL_DAILY_USD="10"
# Folder for stored images. Keep it outside the code, for example /var/www/storage/socialgemstorage
STORAGE_PATH=""

# X (Twitter): each customer signs in with X. Create a Web App at developer.x.com with
# read and write permission and register X_CALLBACK_URL there as the callback.
X_CLIENT_ID=""
X_CLIENT_SECRET=""
X_CALLBACK_URL="https://socialgem.online/api/social/x/callback"
# LinkedIn: each customer signs in with LinkedIn. At linkedin.com/developers add the products
# "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn", and register the callback.
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_CALLBACK_URL="https://socialgem.online/api/social/linkedin/callback"
# Pinterest: each customer signs in with Pinterest. At developers.pinterest.com create an app,
# add the redirect URI below, and request Standard access so Pins are public.
PINTEREST_CLIENT_ID=""
PINTEREST_CLIENT_SECRET=""
PINTEREST_CALLBACK_URL="https://socialgem.online/api/social/pinterest/callback"
# Encrypts stored sign-in tokens. Falls back to NEXTAUTH_SECRET; changing it means reconnecting X.
TOKEN_KEY=""
