# For local work, put DATABASE_URL and TEST_DATABASE_URL for a MySQL on this computer in .env.local.
# MySQL 8. Percent-encode special characters in the password (@ becomes %40).
DATABASE_URL="mysql://user:password@host:3306/socialgem"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

MUAPI_API_KEY="your_muapi_api_key"

STRIPE_SECRET_KEY="your_stripe_secret_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"

# Public contact details (optional; hidden until set)
SUPPORT_EMAIL=""
CONTACT_PHONE=""
CONTACT_WHATSAPP=""

# Email sign-up
AUTH_REQUIRE_EMAIL_VERIFICATION="" # blank: required in production, off in development
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Platforms customers may connect and schedule to
PLATFORMS_ENABLED="facebook,instagram"
