generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum Platform {
  FACEBOOK
  INSTAGRAM
  X
  YOUTUBE
  TIKTOK
  LINKEDIN
  THREADS
  PINTEREST
}

enum AccountStatus {
  ACTIVE
  NEEDS_RECONNECT
  DISCONNECTED
}

enum ConnectStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum TargetStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  NEEDS_CHECK
}

enum AttemptState {
  SENDING
  ACCEPTED
  SUCCEEDED
  FAILED
  AMBIGUOUS
}

enum MediaStatus {
  PENDING
  READY
  REJECTED
  DELETED
}

enum LedgerUnit {
  POST
  AI
}

enum LedgerType {
  GRANT
  RESERVE
  CAPTURE
  RELEASE
  ADJUST
  EXPIRE
}

enum BillingProvider {
  RAZORPAY
  STRIPE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

// ---- People and sign-in (NextAuth) ----

model User {
  id             String            @id @default(cuid())
  name           String?
  email          String?           @unique
  emailVerified  DateTime?
  image          String?           @db.Text
  passwordHash   String?           @db.VarChar(255)
  sessionVersion Int               @default(0)
  isSuperAdmin   Boolean           @default(false)
  disabledAt     DateTime?
  createdAt      DateTime          @default(now())
  accounts       Account[]
  sessions       Session[]
  memberships    WorkspaceMember[]
  billingAccount BillingAccount?
  notifications  Notification[]
  connects       ConnectAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---- Workspaces ----

model Workspace {
  id               String            @id @default(cuid())
  name             String            @db.VarChar(60)
  businessType     String?           @db.VarChar(30)
  timezone         String            @default("Asia/Kolkata") @db.VarChar(64)
  externalUserId   String            @unique @default(cuid())
  billingAccountId String
  emailOnFailure   Boolean           @default(true)
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  billingAccount   BillingAccount    @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  members          WorkspaceMember[]
  accounts         SocialAccount[]
  connects         ConnectAttempt[]
  posts            Post[]
  media            MediaAsset[]
  tags             PostTag[]
  notifications    Notification[]
  brand            BrandProfile?
  research         ContentResearch[]
  plans            ContentPlan[]
  aiJobs           AiJob[]
  aiUsage          AiUsage[]
  ideas            ContentIdea[]

  @@index([billingAccountId])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        MemberRole @default(OWNER)
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

// ---- Connected accounts ----

model SocialAccount {
  id             String        @id @default(cuid())
  workspaceId    String
  platform       Platform
  muapiAccountId Int?          @unique
  claimKey       String?       @unique
  platformUserId String?
  name           String
  avatarUrl      String?       @db.Text
  status         AccountStatus @default(ACTIVE)
  connectedAt    DateTime?
  disconnectedAt DateTime?
  lastCheckedAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  targets        PostTarget[]

  @@unique([workspaceId, id])
  @@index([workspaceId, status])
}

model ConnectAttempt {
  id            String        @id @default(cuid())
  workspaceId   String
  userId        String
  platform      Platform
  nonceHash     String        @unique @db.Char(64)
  knownAccounts Json
  status        ConnectStatus @default(PENDING)
  error         String?
  expiresAt     DateTime
  createdAt     DateTime      @default(now())
  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId])
}

// ---- Content ----

model MediaAsset {
  id          String        @id @default(cuid())
  workspaceId String
  objectKey   String?       @unique
  sourceUrl   String?       @db.VarChar(2083)
  name        String
  mimeType    String        @db.VarChar(100)
  sizeBytes   Int
  width       Int?
  height      Int?
  durationMs  Int?
  codec       String?       @db.VarChar(40)
  folder      String        @default("All Media") @db.VarChar(60)
  tags        String?       @db.VarChar(300)
  status      MediaStatus   @default(PENDING)
  rejectedFor String?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  posts       Post[]
  targets     PostTarget[]
  ideas       ContentIdea[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

model PostTag {
  id          String    @id @default(cuid())
  workspaceId String
  name        String    @db.VarChar(40)
  color       String    @default("#FF6B00") @db.Char(7)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  posts       Post[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, id])
}

model Post {
  id          String       @id @default(cuid())
  workspaceId String
  createdById String
  requestKey  String
  title       String?      @db.VarChar(300)
  caption     String       @db.Text
  mediaId     String?
  tagId       String?
  scheduledAt DateTime?
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  media       MediaAsset?  @relation(fields: [workspaceId, mediaId], references: [workspaceId, id], onDelete: Restrict, map: "Post_media_fkey")
  tag         PostTag?     @relation(fields: [workspaceId, tagId], references: [workspaceId, id], onDelete: Restrict, map: "Post_tag_fkey")
  targets     PostTarget[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, requestKey])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, mediaId])
  @@index([workspaceId, tagId])
}

model PostTarget {
  id              String           @id @default(cuid())
  workspaceId     String
  postId          String
  platform        Platform
  socialAccountId String?
  caption         String?          @db.Text
  mediaId         String?
  options         Json
  status          TargetStatus     @default(DRAFT)
  scheduledAt     DateTime?
  claimAt         DateTime?
  pollAt          DateTime?
  leaseToken      String?          @db.Char(36)
  attemptCount    Int              @default(0)
  publishedAt     DateTime?
  platformPostId  String?
  publishedUrl    String?          @db.VarChar(2083)
  costUsd         Decimal?         @db.Decimal(12, 6)
  errorCode       String?          @db.VarChar(40)
  errorMessage    String?          @db.Text
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  post            Post             @relation(fields: [workspaceId, postId], references: [workspaceId, id], onDelete: Cascade, map: "PostTarget_post_fkey")
  socialAccount   SocialAccount?   @relation(fields: [workspaceId, socialAccountId], references: [workspaceId, id], onDelete: Restrict, map: "PostTarget_account_fkey")
  media           MediaAsset?      @relation(fields: [workspaceId, mediaId], references: [workspaceId, id], onDelete: Restrict, map: "PostTarget_media_fkey")
  attempts        PublishAttempt[]

  @@unique([postId, platform, socialAccountId])
  @@index([claimAt])
  @@index([pollAt])
  @@index([workspaceId, postId])
  @@index([workspaceId, socialAccountId])
  @@index([workspaceId, mediaId])
  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, scheduledAt])
  @@index([status, updatedAt])
}

model PublishAttempt {
  id            String       @id @default(cuid())
  targetId      String
  number        Int
  state         AttemptState @default(SENDING)
  requestId     String?      @unique
  hookTokenHash String?      @unique @db.Char(64)
  httpStatus    Int?
  submitCostUsd Decimal?     @db.Decimal(12, 6)
  resultCostUsd Decimal?     @db.Decimal(12, 6)
  balanceUsd    Decimal?     @db.Decimal(12, 4)
  errorCode     String?      @db.VarChar(40)
  errorMessage  String?      @db.Text
  response      Json?
  sentAt        DateTime     @default(now())
  finishedAt    DateTime?
  target        PostTarget   @relation(fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([targetId, number])
  @@index([state, sentAt])
}

// ---- Billing ----

model BillingAccount {
  id             String         @id @default(cuid())
  ownerUserId    String         @unique
  businessName   String?
  billingAddress Json?
  gstin          String?        @db.VarChar(15)
  trialUsedAt    DateTime?
  createdAt      DateTime       @default(now())
  owner          User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  workspaces     Workspace[]
  subscriptions  Subscription[]
  payments       Payment[]
  ledger         LedgerEntry[]
}

model Subscription {
  id                String             @id @default(cuid())
  billingAccountId  String
  currentKey        String?            @unique
  provider          BillingProvider?
  providerRef       String?
  planKey           String             @db.VarChar(40)
  planSnapshot      Json
  status            SubscriptionStatus
  periodStart       DateTime
  periodEnd         DateTime
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  billingAccount    BillingAccount     @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([billingAccountId, status])
  @@index([status, periodEnd])
}

model Payment {
  id               String          @id @default(cuid())
  billingAccountId String
  provider         BillingProvider
  providerRef      String
  amountMinor      Int
  taxMinor         Int             @default(0)
  currency         String          @db.Char(3)
  status           PaymentStatus
  planKey          String          @db.VarChar(40)
  paidAt           DateTime?
  createdAt        DateTime        @default(now())
  billingAccount   BillingAccount  @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  invoice          Invoice?

  @@unique([provider, providerRef])
  @@index([billingAccountId, createdAt])
  @@index([status, paidAt])
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  number    String   @unique @db.VarChar(16)
  details   Json
  issuedAt  DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model InvoiceSequence {
  fiscalYear String @id @db.VarChar(9)
  lastNumber Int    @default(0)
}

model LedgerEntry {
  id               String         @id @default(cuid())
  billingAccountId String
  unit             LedgerUnit
  type             LedgerType
  amount           Int
  periodKey        String         @db.VarChar(40)
  idempotencyKey   String         @unique
  targetId         String?
  reason           String?
  actorUserId      String?
  createdAt        DateTime       @default(now())
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)

  @@index([billingAccountId, unit, periodKey])
  @@index([targetId])
}

model ProviderEvent {
  id          String    @id @default(cuid())
  provider    String    @db.VarChar(20)
  eventId     String
  type        String    @db.VarChar(80)
  payloadHash String    @db.Char(64)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

// ---- Operations ----

model Notification {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String?
  type        String     @db.VarChar(40)
  data        Json
  dedupeKey   String     @unique
  readAt      DateTime?
  emailAt     DateTime?
  emailTries  Int        @default(0)
  emailedAt   DateTime?
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([workspaceId])
  @@index([emailAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String   @db.VarChar(80)
  entityType  String   @db.VarChar(40)
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model SystemState {
  key       String   @id @db.VarChar(60)
  value     Json
  updatedAt DateTime @updatedAt
}

model RateLimit {
  key         String   @id @db.VarChar(64)
  windowStart DateTime
  count       Int

  @@index([windowStart])
}

// ---- AI studio ----

enum AiJobStatus {
  RUNNING
  DONE
  FAILED
}

enum IdeaStatus {
  IDEA
  READY
  SCHEDULED
}

model BrandProfile {
  workspaceId String    @id
  website     String?   @db.VarChar(300)
  data        Json
  sources     Json
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ContentResearch {
  id          String    @id @default(cuid())
  workspaceId String
  region      String    @db.VarChar(80)
  data        Json
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ContentPlan {
  id          String        @id @default(cuid())
  workspaceId String
  title       String        @db.VarChar(120)
  goal        String        @db.VarChar(500)
  strategy    String        @db.Text
  startDay    String        @db.Char(10)
  days        Int
  platforms   Json
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ideas       ContentIdea[]

  @@unique([workspaceId, id])
  @@index([workspaceId, createdAt])
}

// Owned by a workspace in the database itself: the plan and the image must belong to the same one.
model ContentIdea {
  id          String      @id @default(cuid())
  workspaceId String
  planId      String
  position    Int
  scheduledAt DateTime
  platforms   Json
  format      String      @db.VarChar(10)
  pillar      String      @db.VarChar(60)
  topic       String      @db.VarChar(300)
  angle       String      @db.VarChar(500)
  captions    Json?
  hashtags    String?     @db.VarChar(1000)
  imagePrompt String?     @db.VarChar(1500)
  mediaId     String?
  postId      String?
  status      IdeaStatus  @default(IDEA)
  error       String?     @db.VarChar(300)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan        ContentPlan @relation(fields: [workspaceId, planId], references: [workspaceId, id], onDelete: Cascade, map: "ContentIdea_plan_fkey")
  // Media is only ever soft-deleted, so Restrict never blocks normal use.
  media       MediaAsset? @relation(fields: [workspaceId, mediaId], references: [workspaceId, id], onDelete: Restrict, map: "ContentIdea_media_fkey")

  @@unique([workspaceId, id])
  @@index([workspaceId, planId, scheduledAt])
  @@index([workspaceId, mediaId])
}

model AiJob {
  id          String      @id @default(cuid())
  workspaceId String
  userId      String
  kind        String      @db.VarChar(20)
  input       Json
  status      AiJobStatus @default(RUNNING)
  activeKey   String?     @unique
  step        String      @db.VarChar(300)
  error       String?     @db.VarChar(300)
  heartbeatAt DateTime
  createdAt   DateTime    @default(now())
  finishedAt  DateTime?
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model AiUsage {
  id           String    @id @default(cuid())
  workspaceId  String
  userId       String
  jobId        String?
  provider     String    @db.VarChar(20)
  model        String    @db.VarChar(60)
  task         String    @db.VarChar(20)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  cacheRead    Int       @default(0)
  cacheWrite   Int       @default(0)
  searches     Int       @default(0)
  images       Int       @default(0)
  costUsd      Decimal   @db.Decimal(12, 6)
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}
